<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Console self-test. Targets plain net10.0 so it runs on the build machine
    (Linux) as well as on Windows, which is what makes the core logic verifiable
    without launching the GUI.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VoxQueue.SelfTest</RootNamespace>
    <AssemblyName>VoxQueue.SelfTest</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoxQueue.Core\VoxQueue.Core.csproj" />
  </ItemGroup>

</Project>
